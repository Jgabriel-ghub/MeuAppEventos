<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agenda15ds.Views.ResumoPage"
             Title="Resumo do Evento"
             BackgroundColor="#F4F7FB">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Resumo do Evento"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#17213A" />
            <Label Text="Confira as informações cadastradas."
                   TextColor="#64748B" />

            <Border BackgroundColor="White" Stroke="#E2E8F0"
                    StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Nome, StringFormat='Evento: {0}'}"
                           FontSize="20" FontAttributes="Bold" TextColor="#17213A" />
                    <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" TextColor="#17213A"/>
                    <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" TextColor="#17213A"/>
                    <Label Text="{Binding DuracaoDias, StringFormat='Duração: {0} dia(s)'}" TextColor="#17213A"/>
                    <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}" TextColor="#17213A"/>
                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" TextColor="#17213A"/>
                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C2}'}" />
                    <BoxView HeightRequest="1" Color="#E2E8F0" />
                    <Label Text="Custo total do evento" TextColor="#64748B" />
                    <Label Text="{Binding CustoTotal, StringFormat='{0:C2}'}"
                           FontSize="30" FontAttributes="Bold" TextColor="#1769E0" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar ao cadastro" Clicked="Voltar_Clicked"
                    BackgroundColor="#1769E0" TextColor="White" CornerRadius="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
